-- game_session --------------------------------------------------------------

CREATE TABLE game_session (
    game_session_id       BINARY(16)  NOT NULL,
    child_id              BIGINT      NOT NULL,
    game_id               BIGINT      NOT NULL,
    client_play_id        BINARY(16)  NOT NULL,
    difficulty_code       VARCHAR(30) NULL,
    selected_at           DATETIME(6) NOT NULL,
    play_started_at       DATETIME(6) NOT NULL,
    completed_at          DATETIME(6) NOT NULL,
    play_duration_seconds INT         NOT NULL,
    score                 INT         NOT NULL,
    created_at            DATETIME(6) NOT NULL,
    PRIMARY KEY (game_session_id),
    CONSTRAINT uk_game_session_client_play_id UNIQUE (client_play_id),
    CONSTRAINT fk_game_session_game FOREIGN KEY (game_id) REFERENCES game (game_id)
);

-- game_session_id, client_play_id는 UUID를 BINARY(16)으로 저장한다.
-- difficulty_code는 난이도 정책 확정 전까지 NULL 허용. child FK는 도메인 경계상 걸지 않는다.


-- game_rule_version / fruit_type / fruit_score_config (Fruit Ninja 규칙) ------

CREATE TABLE game_rule_version (
    rule_version_id         BIGINT         NOT NULL AUTO_INCREMENT,
    version_code            VARCHAR(40)    NOT NULL,
    planned_duration_sec    INT            NOT NULL,
    slice_speed_threshold   DECIMAL(10, 4) NOT NULL,
    fruit_spawn_interval_ms INT            NOT NULL,
    max_visible_fruit       INT            NOT NULL,
    active                  BOOLEAN        NOT NULL,
    created_at              DATETIME(6)    NOT NULL,
    updated_at              DATETIME(6)    NOT NULL,
    PRIMARY KEY (rule_version_id),
    CONSTRAINT uk_game_rule_version_code UNIQUE (version_code)
);

CREATE TABLE fruit_type (
    fruit_type_id   BIGINT       NOT NULL AUTO_INCREMENT,
    fruit_code      VARCHAR(40)  NOT NULL,
    name            VARCHAR(100) NOT NULL,
    default_size_px INT          NOT NULL,
    created_at      DATETIME(6)  NOT NULL,
    updated_at      DATETIME(6)  NOT NULL,
    PRIMARY KEY (fruit_type_id),
    CONSTRAINT uk_fruit_type_code UNIQUE (fruit_code)
);

CREATE TABLE fruit_score_config (
    rule_version_id BIGINT NOT NULL,
    fruit_type_id   BIGINT NOT NULL,
    score           INT    NOT NULL,
    PRIMARY KEY (rule_version_id, fruit_type_id),
    CONSTRAINT fk_fruit_score_rule FOREIGN KEY (rule_version_id) REFERENCES game_rule_version (rule_version_id),
    CONSTRAINT fk_fruit_score_type FOREIGN KEY (fruit_type_id)   REFERENCES fruit_type (fruit_type_id)
);


-- fruit_ninja_result / fruit_ninja_fruit_result -----------------------------

CREATE TABLE fruit_ninja_result (
    game_session_id    BINARY(16)  NOT NULL,
    rules_version      VARCHAR(40) NOT NULL,
    total_fruit_count  INT         NOT NULL,
    sliced_fruit_count INT         NOT NULL,
    created_at         DATETIME(6) NOT NULL,
    PRIMARY KEY (game_session_id)
);

CREATE TABLE fruit_ninja_fruit_result (
    fruit_result_id BINARY(16)  NOT NULL,
    game_session_id BINARY(16)  NOT NULL,
    fruit_code      VARCHAR(40) NOT NULL,
    generated_count INT         NOT NULL,
    sliced_count    INT         NOT NULL,
    created_at      DATETIME(6) NOT NULL,
    PRIMARY KEY (fruit_result_id),
    CONSTRAINT uk_fruit_ninja_fruit_session_code UNIQUE (game_session_id, fruit_code)
);


-- recycling_game_result (분리수거) ------------------------------------------

CREATE TABLE recycling_game_result (
    game_session_id  BINARY(16)  NOT NULL,
    rules_version    VARCHAR(40) NOT NULL,
    successful_count INT         NOT NULL,
    wrong_count      INT         NOT NULL,
    created_at       DATETIME(6) NOT NULL,
    PRIMARY KEY (game_session_id),
    CONSTRAINT fk_recycling_result_game_session FOREIGN KEY (game_session_id) REFERENCES game_session (game_session_id),
    CONSTRAINT ck_recycling_result_successful_count CHECK (successful_count >= 0),
    CONSTRAINT ck_recycling_result_wrong_count      CHECK (wrong_count >= 0)
);


-- word_match_result / word_match_problem_result (낱말 맞추기) ----------------

CREATE TABLE word_match_result (
    game_session_id       BINARY(16)  NOT NULL,
    rules_version         VARCHAR(40) NOT NULL,
    solved_word_count     INT         NOT NULL,
    incomplete_word_count INT         NOT NULL,
    wrong_count           INT         NOT NULL,
    hint_used_count       INT         NOT NULL,
    created_at            DATETIME(6) NOT NULL,
    PRIMARY KEY (game_session_id),
    CONSTRAINT fk_word_match_result_session FOREIGN KEY (game_session_id) REFERENCES game_session (game_session_id),
    CONSTRAINT ck_word_match_result_counts CHECK (
        solved_word_count >= 0 AND incomplete_word_count >= 0
        AND wrong_count >= 0 AND hint_used_count >= 0)
);

CREATE TABLE word_match_problem_result (
    word_match_problem_result_id BIGINT      NOT NULL AUTO_INCREMENT,
    game_session_id              BINARY(16)  NOT NULL,
    problem_code                 VARCHAR(40) NOT NULL,
    question_order               INT         NOT NULL,
    word_length                  INT         NOT NULL,
    status                       VARCHAR(20) NOT NULL,
    wrong_count                  INT         NOT NULL,
    hint_used                    BOOLEAN     NOT NULL,
    earned_score                 INT         NOT NULL,
    solve_time_ms                BIGINT      NULL,
    created_at                   DATETIME(6) NOT NULL,
    PRIMARY KEY (word_match_problem_result_id),
    CONSTRAINT uk_word_match_result_order   UNIQUE (game_session_id, question_order),
    CONSTRAINT uk_word_match_result_problem UNIQUE (game_session_id, problem_code),
    CONSTRAINT fk_word_match_problem_result_session FOREIGN KEY (game_session_id) REFERENCES game_session (game_session_id),
    CONSTRAINT ck_word_match_problem_result_status CHECK (status IN ('COMPLETED', 'INCOMPLETE')),
    CONSTRAINT ck_word_match_problem_result_values CHECK (
        question_order >= 1 AND word_length BETWEEN 2 AND 4
        AND wrong_count >= 0 AND earned_score >= 0
        AND (solve_time_ms IS NULL OR solve_time_ms > 0))
);


-- card_round (Dobble 라운드) ------------------------------------------------

CREATE TABLE card_round (
    card_round_id    BINARY(16)  NOT NULL,
    game_session_id  BINARY(16)  NOT NULL,
    round_no         INT         NOT NULL,
    status           VARCHAR(20) NOT NULL,
    comparison_count INT         NOT NULL,
    wrong_count      INT         NOT NULL,
    final_grade      VARCHAR(20) NULL,
    solve_time_ms    BIGINT      NULL,
    created_at       DATETIME(6) NOT NULL,
    PRIMARY KEY (card_round_id),
    CONSTRAINT uk_card_round_session_round UNIQUE (game_session_id, round_no),
    CONSTRAINT fk_card_round_game_session FOREIGN KEY (game_session_id) REFERENCES game_session (game_session_id)
);

CREATE INDEX idx_card_round_game_session ON card_round (game_session_id);

-- round_no는 게임 세션 내 카드 쌍의 제시 순서(1부터). status: COMPLETED | INCOMPLETE.
-- final_grade: PERFECT | EXCELLENT | GOOD. 완료 라운드는 final_grade·solve_time_ms를 채우고
--   미완료 라운드는 둘 다 비운다.


-- ===========================================================================
-- REPORT
-- ===========================================================================

-- daily_report --------------------------------------------------------------

CREATE TABLE daily_report (
    report_id             BIGINT        NOT NULL AUTO_INCREMENT,
    child_id              BIGINT        NOT NULL,
    report_date           DATE          NOT NULL,
    period_started_at     DATETIME(6)   NOT NULL,
    period_ended_at       DATETIME(6)   NOT NULL,
    generation_status     VARCHAR(20)   NOT NULL,
    retry_count           INT           NOT NULL DEFAULT 0,
    processing_started_at DATETIME(6)   NULL,
    completed_at          DATETIME(6)   NULL,
    failed_at             DATETIME(6)   NULL,
    failure_reason        VARCHAR(1000) NULL,
    created_at            DATETIME(6)   NOT NULL,
    updated_at            DATETIME(6)   NOT NULL,
    PRIMARY KEY (report_id),
    CONSTRAINT uk_daily_report_child_date UNIQUE (child_id, report_date)
);

CREATE INDEX idx_daily_report_status_processing ON daily_report (generation_status, processing_started_at);

-- generation_status: PENDING | PROCESSING | COMPLETED | FAILED.
-- 집계 시간대 KST(Asia/Seoul), 범위: 전날 19:00:00 이상 ~ 당일 19:00:00 미만.
-- 게임 또는 리포트 가능한 대화가 하나 이상 있을 때만 PENDING 행을 생성한다.


-- report_generation_attempt -------------------------------------------------

CREATE TABLE report_generation_attempt (
    attempt_id     BIGINT        NOT NULL AUTO_INCREMENT,
    report_id      BIGINT        NOT NULL,
    attempt_number INT           NOT NULL,
    attempt_status VARCHAR(20)   NOT NULL,
    started_at     DATETIME(6)   NOT NULL,
    ended_at       DATETIME(6)   NULL,
    failure_stage  VARCHAR(40)   NULL,
    error_code     VARCHAR(60)   NULL,
    failure_reason VARCHAR(1000) NULL,
    created_at     DATETIME(6)   NOT NULL,
    updated_at     DATETIME(6)   NOT NULL,
    PRIMARY KEY (attempt_id),
    CONSTRAINT uk_report_generation_attempt_number UNIQUE (report_id, attempt_number)
);

CREATE INDEX idx_report_generation_attempt_report ON report_generation_attempt (report_id, attempt_number);

-- attempt_status: PROCESSING | COMPLETED | FAILED.
-- 실패한 스냅샷 저장은 롤백하되 생성 시도 이력은 별도 트랜잭션으로 보존한다.


-- report_manual_regeneration ------------------------------------------------

CREATE TABLE report_manual_regeneration (
    regeneration_id         BIGINT        NOT NULL AUTO_INCREMENT,
    report_id               BIGINT        NOT NULL,
    child_id                BIGINT        NOT NULL,
    parent_id               BIGINT        NOT NULL,
    idempotency_key         VARCHAR(100)  NOT NULL,
    regeneration_status     VARCHAR(20)   NOT NULL,
    requested_at            DATETIME(6)   NOT NULL,
    previous_failure_reason VARCHAR(1000) NULL,
    started_at              DATETIME(6)   NULL,
    ended_at                DATETIME(6)   NULL,
    failure_reason          VARCHAR(1000) NULL,
    created_at              DATETIME(6)   NOT NULL,
    updated_at              DATETIME(6)   NOT NULL,
    PRIMARY KEY (regeneration_id),
    CONSTRAINT uk_report_manual_regeneration_parent_key UNIQUE (parent_id, idempotency_key)
);

CREATE INDEX idx_report_manual_regeneration_report ON report_manual_regeneration (report_id, requested_at);

-- regeneration_status: PENDING | PROCESSING | COMPLETED | FAILED.
-- 수동 재생성 요청자와 접수 시점 실패 사유를 보존한다. daily_report는 같은 트랜잭션에서 잠그고
-- FAILED → PENDING으로 옮겨 중복 재생성 등록을 막는다.


-- report_notification -------------------------------------------------------

CREATE TABLE report_notification (
    notification_id     BIGINT       NOT NULL AUTO_INCREMENT,
    parent_id           BIGINT       NOT NULL,
    report_id           BIGINT       NOT NULL,
    child_id            BIGINT       NOT NULL,
    report_date         DATE         NOT NULL,
    notification_type   VARCHAR(30)  NOT NULL,
    notification_status VARCHAR(20)  NOT NULL,
    message             VARCHAR(200) NOT NULL,
    scheduled_at        DATETIME(6)  NULL,
    delivered_at        DATETIME(6)  NULL,
    read_at             DATETIME(6)  NULL,
    created_at          DATETIME(6)  NOT NULL,
    updated_at          DATETIME(6)  NOT NULL,
    PRIMARY KEY (notification_id),
    CONSTRAINT uk_report_notification_report_type UNIQUE (report_id, notification_type)
);

CREATE INDEX idx_report_notification_parent_created ON report_notification (parent_id, created_at);
CREATE INDEX idx_report_notification_report         ON report_notification (report_id);
CREATE INDEX idx_report_notification_delivery       ON report_notification (delivered_at, scheduled_at);
CREATE INDEX idx_report_notification_unread         ON report_notification (parent_id, notification_status, scheduled_at);

-- notification_type: REPORT_COMPLETED | REPORT_FAILED.  notification_status: UNREAD | READ.
-- message에는 게임 결과·대화 내용·내부 생성 실패 사유를 담지 않는다.
-- scheduled_at이 전송 시각을 정하고, delivered_at이 중복 전송을 막는다. SSE 전송에서
--   전달된(delivered) 행만 Last-Event-ID 복구에 참여한다. read_at은 UNREAD/READ 추적(V7).


-- report_notification_preference --------------------------------------------

CREATE TABLE report_notification_preference (
    preference_id       BIGINT      NOT NULL AUTO_INCREMENT,
    parent_id           BIGINT      NOT NULL,
    enabled             BOOLEAN     NOT NULL,
    notification_minute SMALLINT    NOT NULL,
    time_zone           VARCHAR(50) NOT NULL,
    created_at          DATETIME(6) NOT NULL,
    updated_at          DATETIME(6) NOT NULL,
    PRIMARY KEY (preference_id),
    CONSTRAINT uk_report_notification_preference_parent UNIQUE (parent_id),
    CONSTRAINT chk_report_notification_minute CHECK (notification_minute BETWEEN 0 AND 1439)
);

-- notification_minute: 자정 기준 분(0~1439). V13에서 notification_time(TIME)을 타임존 중립적인
--   minute-of-day 표현으로 전환했다(UTC 저장으로 9시간 어긋났던 Asia/Seoul 값도 함께 복원).


-- report_notification_failure -----------------------------------------------

CREATE TABLE report_notification_failure (
    notification_failure_id BIGINT        NOT NULL AUTO_INCREMENT,
    report_id               BIGINT        NOT NULL,
    notification_type       VARCHAR(30)   NOT NULL,
    failed_at               DATETIME(6)   NOT NULL,
    failure_reason          VARCHAR(1000) NOT NULL,
    created_at              DATETIME(6)   NOT NULL,
    updated_at              DATETIME(6)   NOT NULL,
    PRIMARY KEY (notification_failure_id)
);

CREATE INDEX idx_report_notification_failure_report ON report_notification_failure (report_id, failed_at);

-- 알림 생성 실패는 독립적으로 기록하고 daily_report.generation_status는 바꾸지 않는다.


-- report_game_result --------------------------------------------------------

CREATE TABLE report_game_result (
    report_game_result_id BIGINT       NOT NULL AUTO_INCREMENT,
    report_id             BIGINT       NOT NULL,
    game_session_id       BINARY(16)   NOT NULL,
    game_id               BIGINT       NOT NULL,
    game_code             VARCHAR(40)  NOT NULL,
    game_name             VARCHAR(100) NOT NULL,
    completed_at          DATETIME(6)  NOT NULL,
    play_duration_seconds INT          NOT NULL,
    completed             BOOLEAN      NOT NULL,
    score                 INT          NOT NULL,
    result_metrics        TEXT         NULL,
    created_at            DATETIME(6)  NOT NULL,
    updated_at            DATETIME(6)  NOT NULL,
    PRIMARY KEY (report_game_result_id),
    CONSTRAINT uk_report_game_result_report_session UNIQUE (report_id, game_session_id)
);

-- 완료된 GameSession의 값을 생성 시점 스냅샷으로 복사한다. game_session_id는 원본 추적용(BINARY 16).
-- result_metrics는 게임별 지표(Dobble/FruitNinja 등)를 JSON 문자열로 보관한다.


-- report_conversation_summary -----------------------------------------------

CREATE TABLE report_conversation_summary (
    report_conversation_summary_id BIGINT       NOT NULL AUTO_INCREMENT,
    report_id                      BIGINT       NOT NULL,
    source_conversation_ids        TEXT         NOT NULL,
    diary_title                    VARCHAR(200) NOT NULL,
    diary_content                  TEXT         NOT NULL,
    main_events                    TEXT         NOT NULL,
    emotions                       TEXT         NOT NULL,
    emotion_details                TEXT         NOT NULL,
    interests                      TEXT         NOT NULL,
    notable_quotes                 TEXT         NOT NULL,
    conversation_guide             TEXT         NOT NULL,
    model_version                  VARCHAR(100) NULL,
    prompt_version                 VARCHAR(100) NULL,
    created_at                     DATETIME(6)  NOT NULL,
    updated_at                     DATETIME(6)  NOT NULL,
    PRIMARY KEY (report_conversation_summary_id),
    CONSTRAINT uk_report_conversation_summary_report UNIQUE (report_id)
);

-- AI가 ConversationSummaryPort로 검증된 요약을 반환하면, report 도메인이 게임 결과 스냅샷 및
--   daily_report COMPLETED 상태와 원자적으로 최종 불변 요약을 저장한다.
-- source_conversation_ids는 게임만 있는 서사면 [] 일 수 있다.
-- emotion_details/notable_quotes/conversation_guide는 V10에서 추가(모두 NOT NULL, 기본 빈 값).


-- admin_report_generation_audit ---------------------------------------------

CREATE TABLE admin_report_generation_audit (
    audit_id        BIGINT      NOT NULL AUTO_INCREMENT,
    admin_parent_id BIGINT      NOT NULL,
    child_id        BIGINT      NOT NULL,
    report_id       BIGINT      NOT NULL,
    report_date     DATE        NOT NULL,
    created_at      DATETIME(6) NOT NULL,
    updated_at      DATETIME(6) NOT NULL,
    PRIMARY KEY (audit_id)
);

CREATE INDEX idx_admin_report_audit_admin_created ON admin_report_generation_audit (admin_parent_id, created_at);
CREATE INDEX idx_admin_report_audit_child_date    ON admin_report_generation_audit (child_id, report_date);


-- ===========================================================================
-- CHILD DIARY
-- ===========================================================================

CREATE TABLE child_diary (
    child_diary_id    BIGINT       NOT NULL AUTO_INCREMENT,
    child_id          BIGINT       NOT NULL,
    conversation_id   VARCHAR(40)  NOT NULL,
    diary_date        DATE         NOT NULL,
    title             VARCHAR(20)  NOT NULL,
    lines_json        TEXT         NOT NULL,
    generation_method VARCHAR(20)  NOT NULL,
    model_version     VARCHAR(100) NULL,
    prompt_version    VARCHAR(100) NOT NULL,
    created_at        DATETIME(6)  NOT NULL,
    updated_at        DATETIME(6)  NOT NULL,
    PRIMARY KEY (child_diary_id),
    CONSTRAINT uk_child_diary_conversation UNIQUE (conversation_id)
);

CREATE INDEX idx_child_diary_child_date ON child_diary (child_id, diary_date);

-- generation_method: AI | RULE_BASED.
-- 미리보기는 저장하지 않는다 — 백엔드가 단기 토큰으로 서명하고, 명시적 attach만 이 행을 insert한다.
-- conversation_id UNIQUE가 동시 attach 요청의 중복 일기 생성을 막는다.


