GMS_KEY=
GMS_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1
GMS_ANALYSIS_MODEL=gpt-5.4-nano
GMS_RESPONSE_MODEL=gpt-5.4-mini
GMS_REPORT_MODEL=gpt-5.4-mini
GMS_CHILD_DIARY_MODEL=gpt-5.4-mini
GMS_TIMEOUT_SECONDS=10
GMS_MAX_ATTEMPTS=2

# WebRTC ICE: 빈 값이면 STUN 조회 없이 host 후보만 사용(로컬 기본). NAT 통과가 필요한 배포에서만 쉼표 구분으로 지정.
# 예: REALTIME_STUN_URLS=stun:stun.example.com:3478
REALTIME_STUN_URLS=
