GMS_KEY=
GMS_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1
GMS_ANALYSIS_MODEL=gpt-5.4-nano
GMS_RESPONSE_MODEL=gpt-5-mini
GMS_REPORT_MODEL=gpt-5-mini
GMS_CHILD_DIARY_MODEL=gpt-5-mini
GMS_CHILD_DIARY_TIMEOUT_SECONDS=90
GMS_TIMEOUT_SECONDS=10
GMS_MAX_ATTEMPTS=2

# WebRTC ICE: 빈 값이면 STUN 조회 없이 host 후보만 사용(로컬 기본). NAT 통과가 필요한 배포에서만 쉼표 구분으로 지정.
# 배포는 루트 .env가 담당하므로 이 파일(로컬 단독 실행용)은 빈 값을 유지한다.
# 예: REALTIME_STUN_URLS=stun:stun.l.google.com:19302
REALTIME_STUN_URLS=

# STT (DEC-04: whisper-1 배치). 인증은 GMS_KEY를 재사용한다.
STT_MODEL=whisper-1
STT_LANGUAGE=ko
STT_TIMEOUT_SECONDS=10
STT_MAX_UTTERANCE_SECONDS=30
STT_MIN_UTTERANCE_SECONDS=0.5
STT_NO_SPEECH_PROB_THRESHOLD=0.6

# Turn Detection (W02)
STT_VAD_AGGRESSIVENESS=2
STT_VAD_MIN_FRAME_RMS=250
STT_MIN_SPEECH_MS=250
STT_TRAILING_SILENCE_SECONDS=1.0
STT_PREROLL_MS=300
STT_NO_SPEECH_TIMEOUT_SECONDS=10

# Streaming TTS (W04)
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy
TTS_TIMEOUT_SECONDS=10

# Conversation Event 발행 (W05)
STREAM_PUBLISH_MAX_ATTEMPTS=3
STREAM_PUBLISH_RETRY_SECONDS=0.5
STREAM_OUTBOX_SIZE=256
