# backend/.env 로 복사해 값을 채운다. .env 는 커밋하지 않는다.

# local = 가짜 저장소(AWS 불필요) / s3 = 실제 S3. 운영 환경은 반드시 s3.
STORAGE_PROVIDER=local

AWS_REGION=ap-northeast-2

# STORAGE_PROVIDER=s3 일 때만 필요. EC2에서 IAM 역할을 쓰면 비워둔다.
# 로컬 gradle 실행 시엔 .env 를 세션 환경변수로 올려야 한다: set -a; . ./.env; set +a
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# 웹캠 촬영 사진(아이 실물) 저장용 비공개 버킷.
S3_UPLOAD_BUCKET=your-profile-uploads-bucket
