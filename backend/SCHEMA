        UNIQUE (parent_id, idempotency_key)
);

CREATE INDEX idx_report_manual_regeneration_report
    ON report_manual_regeneration (report_id, requested_at);

-- regeneration_status: PENDING | PROCESSING | COMPLETED | FAILED
-- The row records who requested a manual regeneration and preserves the
-- failure reason that was visible when the request was accepted.
-- The daily_report row is locked and moved from FAILED to PENDING in the same
-- transaction, preventing another regeneration from being registered.
-- Entity: backend/src/main/java/com/A501/backend/domain/report/entity/ReportManualRegeneration.java


-- REPORT-09: report_notification -------------------------------------------

CREATE TABLE report_notification (
    notification_id      BIGINT       NOT NULL AUTO_INCREMENT,
    parent_id            BIGINT       NOT NULL,
    report_id            BIGINT       NOT NULL,
    child_id             BIGINT       NOT NULL,
    report_date          DATE         NOT NULL,
    notification_type    VARCHAR(30)  NOT NULL,
    notification_status  VARCHAR(20)  NOT NULL,
    message              VARCHAR(200) NOT NULL,
    created_at           DATETIME(6)  NOT NULL,
    updated_at           DATETIME(6)  NOT NULL,
    PRIMARY KEY (notification_id),
    CONSTRAINT uk_report_notification_report_type
        UNIQUE (report_id, notification_type)
);

CREATE INDEX idx_report_notification_parent_created
    ON report_notification (parent_id, created_at);

CREATE INDEX idx_report_notification_report
    ON report_notification (report_id);

-- notification_type: REPORT_COMPLETED | REPORT_FAILED
-- notification_status: UNREAD | READ
-- The message contains no game result, conversation content, or internal
-- generation failure reason.
-- REPORT-10 prevents duplicate creation with the report_id and
-- notification_type unique constraint.
-- REPORT-11 delivers stored notifications over SSE. The auto-increment
-- notification_id is used as the SSE event id, and Last-Event-ID recovery
-- queries by (parent_id, notification_id > lastEventId) ordered by
-- notification_id. No column change is required for REPORT-11.
-- Entity: backend/src/main/java/com/A501/backend/domain/report/entity/ReportNotification.java


