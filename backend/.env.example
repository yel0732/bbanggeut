# backend 로컬 실행용 환경변수 예시 파일.
#
# 사용법: 이 파일을 backend/.env 로 복사한 뒤 값을 채운다. backend/.env 는 .gitignore로 제외되어
# 있으며 절대 커밋하지 않는다. 실제 Access Key / Secret Key 는 이 예시 파일에도 적지 않는다.
#
# 배포(EC2)에서는 .env 를 이미지에 넣지 않고, 서버에만 존재하는 .env 를 컨테이너에 주입한다.
#
# 형식 주의: .properties 로 파싱되므로 값에 따옴표를 쓰지 않는다. (O) KEY=value  (X) KEY="value"

# ── 프로필 사진 저장소 ─────────────────────────────────────────
# local = 메모리 가짜 저장소(AWS 계정 없이 실행 가능, 기본값)
# s3    = 실제 S3 사용. 아래 버킷 설정이 비어 있으면 기동에 실패한다.
#
# S3에 저장되는 것은 웹캠 촬영 사진뿐이다. 기본 제공 프로필 이미지(프리셋)는 프론트엔드 번들에
# 포함되어 있어 S3 설정이 필요 없다.
STORAGE_PROVIDER=local

AWS_REGION=ap-northeast-2

# AWS 자격증명. STORAGE_PROVIDER=s3 일 때만 필요하다.
# 값은 backend/.env 에만 넣는다 — 코드·application.yml·Dockerfile·docker-compose.yml·이 파일에는 쓰지 않는다.
# EC2에서는 IAM 역할을 쓰면 이 두 값 없이 동작한다.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# 웹캠 촬영 사진(아이 실물 = 민감정보) 전용 버킷.
# 퍼블릭 액세스 차단을 전부 켠 채로 두고, 접근은 서버가 발급하는 presigned URL로만 이뤄진다.
S3_UPLOAD_BUCKET=your-profile-uploads-bucket
