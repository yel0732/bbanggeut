# Compose
HTTP_PORT=80
HTTPS_PORT=443

# Backend Spring profile. Deployment runs on prod.
BACKEND_PROFILES=prod

NGINX_CONFIG_FILE=./deploy/nginx-http.conf
CERTBOT_WEBROOT=./deploy/certbot/www
LETSENCRYPT_LIVE_DIR=./deploy/certbot/letsencrypt/live/i15a501.p.ssafy.io
LETSENCRYPT_ARCHIVE_DIR=./deploy/certbot/letsencrypt/archive/i15a501.p.ssafy.io

# MySQL: replace every placeholder before deployment.
MYSQL_DATABASE=a501
MYSQL_USER=a501_app
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-password

# Backend
JWT_SECRET=change-to-a-long-random-secret
GOOGLE_CLIENT_ID=replace-with-google-client-id
CORS_ALLOWED_ORIGINS=https://i15a501.p.ssafy.io
REALTIME_SIGNALING_URL=wss://i15a501.p.ssafy.io/realtime/signaling
REALTIME_TICKET_ISSUER=spring-backend
REALTIME_TICKET_AUDIENCE=ai-realtime
REALTIME_TICKET_PRIVATE_KEY_PEM=replace-with-pkcs8-private-key-pem
REALTIME_TICKET_PUBLIC_KEY_PEM=replace-with-x509-public-key-pem
REPORT_SCHEDULE_ENABLED=true
REPORT_DAILY_CRON=0 * * * * *
REPORT_RECOVERY_ENABLED=true
# Account hard delete. MUST be set to true in deployment — otherwise withdrawal
# stops at soft delete plus anonymization, which looks healthy while data piles up.
# Kept false here because purging is irreversible: a wrong false is recoverable,
# a wrong true is not.
ACCOUNT_PURGE_ENABLED=false
ACCOUNT_PURGE_CRON=0 */5 * * * *
ACCOUNT_PURGE_GRACE_PERIOD=0d
# Realtime conversation pipeline. All three must stay true in deployment:
# stream consumer persists FastAPI conversation events to MySQL (diary source),
# recovery drains failed deliveries, reconciler cleans up disconnected sessions.
CONVERSATION_STREAM_ENABLED=true
CONVERSATION_STREAM_RECOVERY_ENABLED=true
REALTIME_RECONCILER_ENABLED=true
# ICE servers handed to the browser's RTCPeerConnection (comma-separated).
# Must be set together with REALTIME_STUN_URLS below — WebRTC media flows
# directly between browser and ai-server (not through nginx), so both sides
# need a STUN-derived public candidate to reach each other across NAT.
REALTIME_ICE_SERVERS=stun:stun.l.google.com:19302

# Private profile-image storage.
# Production must use s3. Keep credentials empty only when the runtime has an IAM role.
STORAGE_PROVIDER=s3
AWS_REGION=ap-northeast-2
S3_UPLOAD_BUCKET=replace-with-private-profile-upload-bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# AI Server
GMS_KEY=replace-with-gms-key
GMS_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1
GMS_ANALYSIS_MODEL=gpt-5.4-nano
GMS_RESPONSE_MODEL=gpt-5.4-mini
GMS_REPORT_MODEL=gpt-5.4-mini
GMS_CHILD_DIARY_MODEL=gpt-5.4-mini
# STUN for aiortc inside the container. Empty = host-only candidates
# (container-internal IP), which can never be reached from an external browser.
REALTIME_STUN_URLS=stun:stun.l.google.com:19302
