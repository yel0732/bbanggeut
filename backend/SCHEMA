-- ===========================================================================
-- AUTH
-- ===========================================================================

-- parent --------------------------------------------------------------------

CREATE TABLE parent (
    parent_id           BIGINT       NOT NULL AUTO_INCREMENT,
    email               VARCHAR(255) NOT NULL,
    password_hash       VARCHAR(255) NULL,
    birth_date          DATE         NOT NULL,
    provider            VARCHAR(20)  NOT NULL,
    provider_id         VARCHAR(255) NULL,
    role                VARCHAR(20)  NOT NULL DEFAULT 'PARENT',
    pin_hash            VARCHAR(255) NULL,
    pin_failed_attempts INT          NOT NULL DEFAULT 0,
    pin_locked_until    DATETIME(6)  NULL,
    pin_set_at          DATETIME(6)  NULL,
    profile_image_key   VARCHAR(512) NOT NULL DEFAULT 'profile-presets/parent-avatar',
    profile_image_num   INT          NOT NULL DEFAULT 1,
    deleted_at          DATETIME(6)  NULL,
    created_at          DATETIME(6)  NOT NULL,
    updated_at          DATETIME(6)  NOT NULL,
    PRIMARY KEY (parent_id),
    CONSTRAINT uk_parent_email       UNIQUE (email),
    CONSTRAINT uk_parent_provider_id UNIQUE (provider_id),
    CONSTRAINT chk_parent_role       CHECK (role IN ('PARENT', 'ADMIN'))
);

-- provider: LOCAL | GOOGLE. LOCAL은 password_hash, GOOGLE은 provider_id 사용.
-- role: PARENT | ADMIN (V14).
-- password_hash, pin_hash 모두 BCrypt(평문 미저장). pin_hash NULL = PIN 미설정.
-- PIN 잠금: pin_failed_attempts 5회 도달 시 pin_locked_until = now + 5분(정책 app.pin.*).
-- profile_image_key: 프리셋/업로드를 단일 키로 표현하고 저장 위치는 키 접두사로 구분한다.
--   profile-presets/*  = 클라이언트 번들 프리셋 식별자(S3에 실물 없음, url=null).
--   profile-uploads/*  = 사용자 업로드·웹캠 사진(민감정보, 비공개 버킷 + presigned GET 단기 TTL).
-- profile_image_num: V4에서 profile_image_key로 전환하며 제거했다가 V5에서 롤백 호환용으로
--   복원한 shadow 컬럼. 엔티티는 매핑하지 않으며 이전 백엔드 이미지 롤백 시에만 의미가 있다.
-- 소프트 삭제: 탈퇴 시 deleted_at 기록. 인증 경로는 deleted_at IS NULL만 유효 취급.


-- refresh_token -------------------------------------------------------------

CREATE TABLE refresh_token (
    id          BIGINT      NOT NULL AUTO_INCREMENT,
    parent_id   BIGINT      NOT NULL,
    token_hash  VARCHAR(64) NOT NULL,
    expires_at  DATETIME(6) NOT NULL,
    revoked     BOOLEAN     NOT NULL DEFAULT FALSE,
    remember_me BOOLEAN     NOT NULL,
    created_at  DATETIME(6) NOT NULL,
    updated_at  DATETIME(6) NOT NULL,
    PRIMARY KEY (id),
    CONSTRAINT uk_refresh_token_hash UNIQUE (token_hash),
    CONSTRAINT fk_refresh_token_parent FOREIGN KEY (parent_id) REFERENCES parent (parent_id)
);

-- token_hash는 SecureRandom opaque 토큰의 SHA-256 해시(원문 미저장).
-- remember_me: 재발급(rotation) 시 만료 정책(자동로그인 60일 / 미체크 1일)을 유지하기 위해 보관.
-- 재사용 감지: 이미 revoked된 토큰으로 재발급 시도 시 해당 parent의 모든 유효 토큰을 폐기.
-- parent_id는 FK 제약이 있어 MySQL이 인덱스를 자동 생성한다(별도 CREATE INDEX 없음).


-- ===========================================================================
-- CHILD
-- ===========================================================================

CREATE TABLE child (
    child_id          BIGINT       NOT NULL AUTO_INCREMENT,
    parent_id         BIGINT       NOT NULL,
    name              VARCHAR(15)  NOT NULL,
    profile_image_key VARCHAR(512) NOT NULL DEFAULT 'profile-presets/child-avatar',
    profile_image_num INT          NOT NULL DEFAULT 1,
    deleted_at        DATETIME(6)  NULL,
    created_at        DATETIME(6)  NOT NULL,
    updated_at        DATETIME(6)  NOT NULL,
    PRIMARY KEY (child_id)
);

CREATE INDEX idx_child_parent_active ON child (parent_id, deleted_at);

-- 닉네임 중복: 같은 부모 아래 삭제되지 않은 자녀끼리만 name이 유일해야 한다. 단순
--   UNIQUE(parent_id, name)은 소프트 삭제된 이름의 재사용까지 막으므로 DB 함수 기반 유니크
--   인덱스가 필요하고(H2 local 표현 불가), 실질 방어선은 ChildService의 애플리케이션 체크다.
-- profile_image_key: parent와 동일한 단일 키 규칙. profile_image_num은 V5 롤백 호환 shadow.
-- 소프트 삭제: 자녀 삭제(PIN 검증) 및 부모 탈퇴 시 deleted_at 기록. 배치는 deleted_at IS NULL을
--   활성 자녀 판정 기준으로 쓴다. 부모당 최대 자녀 수(10명)는 app.child.max-profile-count에서 강제.


-- ===========================================================================
-- CONVERSATION
-- ===========================================================================

-- conversation_session ------------------------------------------------------

CREATE TABLE conversation_session (
    conversation_id                  VARCHAR(40) NOT NULL,
    child_id                         BIGINT      NOT NULL,
    status                           VARCHAR(20) NOT NULL,
    current_topic                    VARCHAR(20) NOT NULL,
    question_count                   INT         NOT NULL,
    max_question_count               INT         NOT NULL,
    current_session_epoch            INT         NOT NULL,
    current_session_epoch_started_at DATETIME(6) NULL,
    started_at                       DATETIME(6) NULL,
    completed_at                     DATETIME(6) NULL,
    termination_reason               VARCHAR(40) NULL,
    version                          BIGINT      NOT NULL DEFAULT 0,
    created_at                       DATETIME(6) NOT NULL,
    updated_at                       DATETIME(6) NOT NULL,
    PRIMARY KEY (conversation_id)
);

CREATE INDEX idx_conversation_session_child_status  ON conversation_session (child_id, status);
CREATE INDEX idx_conversation_session_status_updated ON conversation_session (status, updated_at);

-- status: READY | IN_PROGRESS | COMPLETED | ABORTED | EXPIRED | FAILED
-- termination_reason: USER_FINISHED | MAX_QUESTION_REACHED | CHILD_REQUESTED_STOP
--   | REQUIRED_SLOTS_FILLED | INACTIVITY_TIMEOUT | CONNECTION_LOST | PAGE_CLOSED | SYSTEM_ERROR


-- conversation_topic_state --------------------------------------------------

CREATE TABLE conversation_topic_state (
    conversation_topic_id VARCHAR(50) NOT NULL,
    conversation_id       VARCHAR(40) NOT NULL,
    topic_type            VARCHAR(20) NOT NULL,
    topic_order           INT         NOT NULL,
    status                VARCHAR(20) NOT NULL,
    question_count        INT         NOT NULL,
    max_question_count    INT         NOT NULL,
    slots_json            TEXT        NOT NULL,
    context_json          TEXT        NOT NULL,
    skipped_targets_json  TEXT        NOT NULL,
    completion_reason     VARCHAR(40) NULL,
    started_at            DATETIME(6) NULL,
    completed_at          DATETIME(6) NULL,
    version               BIGINT      NOT NULL DEFAULT 0,
    created_at            DATETIME(6) NOT NULL,
    updated_at            DATETIME(6) NOT NULL,
    PRIMARY KEY (conversation_topic_id),
    CONSTRAINT uk_conversation_topic_type  UNIQUE (conversation_id, topic_type),
    CONSTRAINT uk_conversation_topic_order UNIQUE (conversation_id, topic_order)
);

CREATE INDEX idx_conversation_topic_status ON conversation_topic_state (conversation_id, status);

-- topic_type: GAME | DAILY.  status: PENDING | IN_PROGRESS | COMPLETED.
-- question_count/max_question_count는 토픽 단위 범위다.
-- 같은 KST 하루의 완료된 게임 여러 개가 하나의 GAME 토픽에 연결된다.


-- conversation_game_session -------------------------------------------------

CREATE TABLE conversation_game_session (
    conversation_game_session_id VARCHAR(80) NOT NULL,
    conversation_id              VARCHAR(40) NOT NULL,
    game_session_id              BINARY(16)  NOT NULL,
    game_order                   INT         NOT NULL,
    created_at                   DATETIME(6) NOT NULL,
    updated_at                   DATETIME(6) NOT NULL,
    PRIMARY KEY (conversation_game_session_id),
    CONSTRAINT uk_conversation_game_session UNIQUE (conversation_id, game_session_id),
    CONSTRAINT uk_conversation_game_order   UNIQUE (conversation_id, game_order)
);


-- conversation_turn ---------------------------------------------------------

CREATE TABLE conversation_turn (
    turn_id             VARCHAR(40)  NOT NULL,
    conversation_id     VARCHAR(40)  NOT NULL,
    turn_seq            INT          NOT NULL,
    speaker             VARCHAR(10)  NOT NULL,
    topic_type          VARCHAR(20)  NOT NULL,
    content             TEXT         NOT NULL,
    question_text       TEXT         NULL,
    question_target     VARCHAR(30)  NULL,
    status              VARCHAR(20)  NOT NULL,
    response_id         VARCHAR(40)  NULL,
    stt_confidence      DECIMAL(5,4) NULL,
    started_at          DATETIME(6)  NULL,
    completed_at        DATETIME(6)  NULL,
    interrupted_at      DATETIME(6)  NULL,
    interruption_reason VARCHAR(40)  NULL,
    interruption_id     VARCHAR(40)  NULL,
    version             BIGINT       NOT NULL DEFAULT 0,
    created_at          DATETIME(6)  NOT NULL,
    updated_at          DATETIME(6)  NOT NULL,
    PRIMARY KEY (turn_id),
    CONSTRAINT uk_conversation_turn_seq UNIQUE (conversation_id, turn_seq)
);

CREATE INDEX idx_conversation_turn_response_id     ON conversation_turn (response_id);
CREATE INDEX idx_conversation_turn_interruption_id ON conversation_turn (interruption_id);

-- speaker: AI | CHILD.  status: GENERATING | COMPLETED | INTERRUPTED | FAILED.
-- question_text: AI 표시 문장과 분리된 다음 턴 판정용 순수 질문(CHILD 턴은 NULL).
-- question_target: 이 질문이 채우려는 슬롯/목표(V8, CHILD 턴은 NULL).


-- conversation_event / conversation_event_failure ---------------------------

CREATE TABLE conversation_event (
    event_id            VARCHAR(80) NOT NULL,
    redis_record_id     VARCHAR(80) NOT NULL,
    conversation_id     VARCHAR(40) NOT NULL,
    realtime_session_id VARCHAR(80) NOT NULL,
    session_epoch       INT         NOT NULL,
    event_type          VARCHAR(40) NOT NULL,
    turn_id             VARCHAR(40) NULL,
    occurred_at         DATETIME(6) NOT NULL,
    processed_at        DATETIME(6) NOT NULL,
    processing_result   VARCHAR(30) NOT NULL,
    created_at          DATETIME(6) NOT NULL,
    updated_at          DATETIME(6) NOT NULL,
    PRIMARY KEY (event_id),
    CONSTRAINT uk_conversation_event_redis_record UNIQUE (redis_record_id)
);

CREATE INDEX idx_conversation_event_conversation_epoch ON conversation_event (conversation_id, session_epoch);
CREATE INDEX idx_conversation_event_turn               ON conversation_event (conversation_id, turn_id);

CREATE TABLE conversation_event_failure (
    conversation_event_failure_id BIGINT        NOT NULL AUTO_INCREMENT,
    redis_record_id               VARCHAR(80)   NOT NULL,
    event_id                      VARCHAR(80)   NULL,
    conversation_id               VARCHAR(40)   NULL,
    event_type                    VARCHAR(40)   NULL,
    delivery_count                BIGINT        NOT NULL,
    failed_at                     DATETIME(6)   NOT NULL,
    failure_reason                VARCHAR(1000) NOT NULL,
    created_at                    DATETIME(6)   NOT NULL,
    updated_at                    DATETIME(6)   NOT NULL,
    PRIMARY KEY (conversation_event_failure_id),
    CONSTRAINT uk_conversation_event_failure_record UNIQUE (redis_record_id)
);

CREATE INDEX idx_conversation_event_failure_record ON conversation_event_failure (redis_record_id);

-- processing_result: APPLIED | IGNORED_STALE.
-- 원본 이벤트 payload·transcript는 의도적으로 두 테이블 어디에도 복사하지 않는다.


