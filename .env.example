# Compose
HTTP_PORT=80
HTTPS_PORT=443
NGINX_CONFIG_FILE=./deploy/nginx-http.conf
CERTBOT_WEBROOT=./deploy/certbot/www
LETSENCRYPT_LIVE_DIR=./deploy/certbot/letsencrypt/live/i15a501.p.ssafy.io
LETSENCRYPT_ARCHIVE_DIR=./deploy/certbot/letsencrypt/archive/i15a501.p.ssafy.io
# Keep production on prod only. For local Compose verification while the
# production conversation adapters are unfinished, use prod,container-test.
BACKEND_PROFILES=prod

# MySQL: replace every placeholder before deployment.
MYSQL_DATABASE=a501
MYSQL_USER=a501_app
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-password

# Backend
JWT_SECRET=change-to-a-long-random-secret
GOOGLE_CLIENT_ID=replace-with-google-client-id
CORS_ALLOWED_ORIGINS=https://i15a501.p.ssafy.io
REALTIME_SIGNALING_URL=wss://i15a501.p.ssafy.io/realtime/signaling
REALTIME_TICKET_ISSUER=spring-backend
REALTIME_TICKET_AUDIENCE=ai-realtime
REALTIME_TICKET_PRIVATE_KEY_PEM=replace-with-pkcs8-private-key-pem
REALTIME_TICKET_PUBLIC_KEY_PEM=replace-with-x509-public-key-pem
REPORT_SCHEDULE_ENABLED=true
REPORT_RECOVERY_ENABLED=true

# AI Server
GMS_KEY=replace-with-gms-key
GMS_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1
GMS_ANALYSIS_MODEL=gpt-5.4-nano
GMS_RESPONSE_MODEL=gpt-5.4-mini
GMS_REPORT_MODEL=gpt-5.4-mini
GMS_CHILD_DIARY_MODEL=gpt-5.4-mini
REALTIME_STUN_URLS=
